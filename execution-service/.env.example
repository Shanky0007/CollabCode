# Server
PORT=4000
FRONTEND_URL=http://localhost:3000

# Supabase (use service role key for internal writes — never expose this)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Upstash Redis (use rediss:// for TLS)
UPSTASH_REDIS_URL=rediss://your-upstash-url:6379
UPSTASH_REDIS_TOKEN=your-upstash-token

# Judge0 CE — choose ONE option:
# Option A — RapidAPI hosted (works everywhere, free 50 req/day)
# Sign up at https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_RAPIDAPI_KEY=your-rapidapi-key
# Option B — self-hosted (Linux/Mac only; Docker Desktop on Windows has isolate sandbox issues)
JUDGE0_URL=http://localhost:2358
JUDGE0_TOKEN=
