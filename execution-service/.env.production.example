# =============================================================================
# CollabCode execution-service — PRODUCTION env vars (set these in Render)
# Render → Service → Environment. Do NOT commit real values.
# =============================================================================

PORT=4000

# Frontend origin(s) for CORS — your Vercel URL, NO trailing slash.
# Comma-separate to allow more than one (e.g. prod + a preview domain).
FRONTEND_URL=https://your-app.vercel.app

# Supabase — service role key (server-only, bypasses RLS for internal writes)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Upstash Redis — create a free DB at upstash.com, use the rediss:// TLS URL.
# The credentials are embedded in the URL; UPSTASH_REDIS_TOKEN is optional.
UPSTASH_REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
UPSTASH_REDIS_TOKEN=

# Judge0 CE — choose ONE:
# Option A (recommended for prod): RapidAPI hosted
JUDGE0_RAPIDAPI_KEY=your-rapidapi-key
# Option B: self-hosted / community endpoint
JUDGE0_URL=https://ce.judge0.com
JUDGE0_TOKEN=
